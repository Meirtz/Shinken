# Shinken CUA-Gym TASK image — NOT the production base.
#
# Extends the lean base (shinken/sandbox-linux) with what the released CUA-Gym task
# bundles' setup/reward scripts actually use (measured over all 10,910 bundles of
# cua_gym_tasks_v1: python-docx 7.5k, openpyxl 5.6k, python-pptx 5.5k, requests 3.0k,
# pymupdf 0.5k, lxml/PIL/odfpy/pandas/numpy/PyPDF2 in the tail), plus pip and the
# CLI utilities task scripts shell out to. The base image stays lean; this is the
# Dockerfile.a11y pattern applied to the RL-task surface.
#
# Build (from repo root, AFTER building the base):
#   docker build -f images/linux/Dockerfile -t shinken/sandbox-linux .
#   docker build -f images/linux/Dockerfile.cua -t shinken/sandbox-cua .

FROM shinken/sandbox-linux

USER root
ENV DEBIAN_FRONTEND=noninteractive
# Task setup scripts pip-install their own deps (measured); let them through PEP 668.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-openpyxl python3-requests python3-lxml python3-pil python3-odf \
        python3-pandas python3-numpy python3-pypdf2 python3-fitz python3-reportlab \
        python3-matplotlib \
        poppler-utils xdg-utils zip unzip curl wget file \
    && rm -rf /var/lib/apt/lists/*
# Not packaged by Debian: the two top Office writers task scripts import the most.
RUN pip install --no-cache-dir --break-system-packages python-docx python-pptx

# The desktop_app class (9.2k of 10.9k bundles; 6.5k LibreOffice) — setup scripts convert
# documents with headless soffice and tweak the desktop with gsettings. arm64-native.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-calc libreoffice-writer libreoffice-impress \
        libglib2.0-bin dbus-x11 fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

USER shinken

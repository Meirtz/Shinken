{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinken.dev/schema/skn/v0",
  "title": "Shinken .skn v0 — replay bundle",
  "description": "The .skn replay/trajectory format v0. A bundle is a directory or zip: manifest.json + events.jsonl (one Event per line) + media/<sha256>. The event stream IS the live stream and the replay log. See docs/05-tech-decisions.md (D5) and docs/10-phase0-plan.md.",
  "$defs": {
    "Manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["skn_version", "session_id", "run_id", "t0_wall", "platform"],
      "properties": {
        "skn_version": { "type": "integer", "const": 0 },
        "session_id": { "type": "string" },
        "run_id": { "type": "string" },
        "t0_wall": { "type": "string", "description": "ISO-8601 wall-clock anchor" },
        "t0_mono": { "type": "number", "description": "monotonic anchor (seconds)" },
        "platform": { "enum": ["linux", "windows", "macos"] },
        "aci_version": { "type": "integer" },
        "capabilities": { "$ref": "#/$defs/CapabilityEnvelope" },
        "redaction": {
          "type": "object",
          "description": "privacy controls applied to this run (#88)",
          "properties": {
            "media": { "type": "boolean", "description": "screenshot/media bytes dropped" },
            "text": { "type": "boolean", "description": "typed text stripped from actions" }
          }
        },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/EventKind" } },
        "title": { "type": "string" }
      }
    },
    "CapabilityFlag": { "anyOf": [ { "type": "boolean" }, { "const": "ask" } ], "description": "granted (true) / denied (false) / requires approval (\"ask\", #7)" },
    "CapabilityEnvelope": {
      "type": "object",
      "description": "v0 session capability envelope — reference semantics (recorded/auditable), NOT Cedar/ocap/OS enforcement",
      "properties": {
        "input_automation": { "$ref": "#/$defs/CapabilityFlag" },
        "screenshot": { "$ref": "#/$defs/CapabilityFlag" },
        "a11y": { "$ref": "#/$defs/CapabilityFlag" },
        "fs_scope": { "type": ["string", "null"] },
        "egress": { "type": ["boolean", "string"] },
        "credentials": { "$ref": "#/$defs/CapabilityFlag" },
        "clipboard": { "$ref": "#/$defs/CapabilityFlag" },
        "privileged_install": { "$ref": "#/$defs/CapabilityFlag" }
      }
    },
    "Event": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "dt", "kind", "src", "payload"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "monotonic logical clock" },
        "dt": { "type": "number", "description": "seconds since t0_mono" },
        "kind": { "$ref": "#/$defs/EventKind" },
        "src": { "type": "string", "description": "per-kind subtype, e.g. action:click, observation:a11y_diff, permission:ask" },
        "action_id": { "type": "string", "description": "pairs an action with its resulting observation" },
        "batch_id": { "type": "string", "description": "groups actions dispatched as one ordered batch (#73)" },
        "snapshot_ref": { "type": "string", "description": "checkpoint id for kind=snapshot_ref" },
        "payload": { "type": "object" }
      },
      "allOf": [
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "verifier_receipt" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/VerifierReceipt" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "file_transfer" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/FileTransferPayload" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "action" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/ActionPayload" } } } }
      ]
    },
    "EventKind": { "enum": ["action", "observation", "decision", "permission", "marker", "snapshot_ref", "file_transfer", "verifier_receipt", "meta"] },
    "VerifierReceipt": { "type": "object", "additionalProperties": false, "required": ["passed", "checks"], "description": "eval verifier verdict recorded as a verifier_receipt event (#149)", "properties": { "passed": { "type": "boolean" }, "checks": { "type": "array", "items": { "type": "object", "required": ["name", "ok"], "properties": { "name": { "type": "string" }, "ok": { "type": "boolean" }, "evidence": {} } } } } },
    "FileTransferPayload": { "type": "object", "additionalProperties": false, "required": ["direction", "sha256", "size", "scope"], "description": "file_transfer event payload — content-addressed ref, never bytes (#85/#150)", "properties": { "direction": { "enum": ["put", "get"] }, "path": { "type": "string" }, "sha256": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "scope": { "type": "string" }, "stored": { "type": "boolean" } } },
    "ActionPayload": { "type": "object", "required": ["verb"], "description": "action event payload — a canonical ACI action (verb + params); the ACI Action schema is the source of truth for the full shape (#150)", "properties": { "verb": { "type": "string" } } }
  },
  "oneOf": [
    { "$ref": "#/$defs/Manifest" },
    { "$ref": "#/$defs/Event" }
  ]
}
